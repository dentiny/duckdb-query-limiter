# name: test/sql/query_limiter_estimate.test
# description: test dry-run scan estimates
# group: [sql]

load {TEST_DIR}/query_limiter_estimate.db

require query_limiter

statement ok
CREATE TABLE estimate_left AS SELECT i FROM range(5) tbl(i);

statement ok
CREATE TABLE estimate_right AS SELECT i FROM range(7) tbl(i);

statement ok
CHECKPOINT;

restart

statement ok
LOAD query_limiter;

# The function reports the estimate used by the limiter without executing the query.
query II
SELECT estimate.estimated_rows, estimate.unknown_scans
FROM (SELECT query_limiter_estimate('SELECT sum(i) FROM estimate_left') AS estimate);
----
5	0

# Estimates include every scan in the optimized plan.
query II
SELECT estimate.estimated_rows, estimate.unknown_scans
FROM (
	SELECT query_limiter_estimate(
		'SELECT * FROM estimate_left, estimate_right WHERE estimate_left.i = estimate_right.i'
	) AS estimate
);
----
12	0

# The inspected statement is planned but not executed.
query II
SELECT estimate.estimated_rows, estimate.unknown_scans
FROM (SELECT query_limiter_estimate('SELECT error(''must not execute'')') AS estimate);
----
0	0

# Inspection remains available even when the inspected query exceeds the active limit.
statement ok
SET max_rows_to_scan = 1;

query II
SELECT estimate.estimated_rows, estimate.unknown_scans
FROM (SELECT query_limiter_estimate('SELECT sum(i) FROM estimate_left') AS estimate);
----
5	0

statement ok
SET max_rows_to_scan_unknown = 'reject';

# A scalar estimate does not introduce an unknown input scan in its outer query.
query II
SELECT estimate.estimated_rows, estimate.unknown_scans
FROM (SELECT query_limiter_estimate('SELECT 42') AS estimate);
----
0	0

statement error
SELECT query_limiter_estimate('SELECT 1; SELECT 2');
----
query_limiter_estimate requires exactly one SQL statement

# SQL function and setting names remain case-insensitive identifiers.
statement ok
SET MAX_ROWS_TO_SCAN = 0;

statement ok
SET MAX_ROWS_TO_SCAN_UNKNOWN = 'ReJeCt';

query II
SELECT e.ESTIMATED_ROWS, e.UNKNOWN_SCANS
FROM (SELECT QUERY_LIMITER_ESTIMATE('SELECT 42') AS e);
----
0	0

statement ok
RESET max_rows_to_scan;

statement ok
RESET max_rows_to_scan_unknown;

# Constant and NULL inputs propagate correctly across a complete vector.
query III
SELECT count(*), count(e), sum(e.estimated_rows)
FROM (SELECT query_limiter_estimate('SELECT 42') AS e FROM range(3000));
----
3000	3000	0

query I
SELECT query_limiter_estimate(NULL) IS NULL;
----
true

# Filtering produces selected input rows; the discarded SQL must never be planned.
query II
SELECT e.estimated_rows, e.unknown_scans
FROM (
	SELECT query_limiter_estimate(q) AS e
	FROM (VALUES (0, 'invalid SQL'), (1, 'SELECT 42'), (2, NULL), (3, 'SELECT 43')) v(i, q)
	WHERE i > 0
);
----
0	0
NULL	NULL
0	0

# Reusing result vectors across chunks must not retain NULL bits from previous chunks.
query III
SELECT count(*), count(e), sum(e.unknown_scans)
FROM (
	SELECT query_limiter_estimate(CASE WHEN i % 2 = 0 THEN NULL ELSE 'SELECT 42' END) AS e
	FROM range(5000) v(i)
);
----
5000	2500	0

# Parse and bind failures must release the nested-planning guard.
statement error
SELECT query_limiter_estimate('SELECT FROM');
----
Parser Error

statement error
SELECT query_limiter_estimate('SELECT * FROM missing_query_limiter_table');
----
does not exist

query II
SELECT e.estimated_rows, e.unknown_scans
FROM (SELECT query_limiter_estimate('SELECT 42') AS e);
----
0	0

# Planner::Optimize applies mandatory aggregate rewrites even with optional optimization disabled.
statement ok
SET enable_optimizer = false;

query II
SELECT e.estimated_rows, e.unknown_scans
FROM (SELECT query_limiter_estimate('SELECT count(*) FROM range(5)') AS e);
----
5	0

statement ok
RESET enable_optimizer;
