# name: test/sql/query_limiter_metadata.test
# description: test catalog metadata for query_limiter test functions
# group: [sql]

require notwindows

require query_limiter

require allow_unsigned_extensions

statement ok
LOAD query_limiter;

statement ok
LOAD '{BUILD_DIRECTORY}/extension/query_limiter/query_limiter_test.duckdb_extension';

query I
SELECT count(*)
FROM duckdb_functions()
WHERE function_name IN ('query_limiter_estimate', 'query_limiter_unknown_estimate')
AND description IS NOT NULL
AND examples IS NOT NULL
AND categories IS NOT NULL
AND parameters IS NOT NULL;
----
2
